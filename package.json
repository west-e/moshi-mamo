{
  "name": "moshi-mamo",
  "version": "1.0.0",
  "description": "固定電話の通話中に、会話の流れから特殊詐欺の兆候をとらえて本人に知らせる見守りの試作品",
  "main": "index.js",
  "scripts": {
    "test": "npm run typecheck",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "eval": "node --env-file-if-exists=.env --import tsx eval/run.ts",
    "check-secrets": "node scripts/check-secrets.mjs --all",
    "stt": ".venv/Scripts/python stt/server.py",
    "dev:all": "concurrently -k -n api,web,stt -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:stt\""
  },
  "license": "MIT",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
